<%- include('../partials/header') %>
<div class="admin-layout">
  <nav class="admin-sidebar">
    <div class="admin-sidebar-title">Main</div>
    <a href="/admin" class="sidebar-link active"><span class="sidebar-link-icon">📊</span>Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><span class="sidebar-link-icon">📦</span>Products</a>
    <a href="/admin/products/new" class="sidebar-link"><span class="sidebar-link-icon">➕</span>Add Product</a>
    <div class="admin-sidebar-title">Store</div>
    <a href="/products" class="sidebar-link"><span class="sidebar-link-icon">🛍️</span>View Store</a>
    <a href="/" class="sidebar-link"><span class="sidebar-link-icon">🏠</span>Homepage</a>
    <div class="admin-sidebar-title">Account</div>
    <a href="/logout" class="sidebar-link"><span class="sidebar-link-icon">🚪</span>Logout</a>
  </nav>
  <div class="admin-main">
    <div class="admin-topbar">
      <div>
        <h1>Dashboard</h1>
        <p>Welcome back, <%= currentUser?currentUser.name:'Admin' %>! Here's what's happening.</p>
      </div>
      <a href="/admin/products/new" class="btn btn-primary">+ Add Product</a>
    </div>

    <div class="stats-grid">
      <div class="stat-card stat-card-1">
        <div class="stat-top"><div class="stat-icon stat-icon-1">📦</div><span class="stat-trend">+12%</span></div>
        <div class="stat-value"><%= totalProducts %></div>
        <div class="stat-label">Total Products</div>
      </div>
      <div class="stat-card stat-card-2">
        <div class="stat-top"><div class="stat-icon stat-icon-2">🏷️</div><span class="stat-trend">Active</span></div>
        <div class="stat-value"><%= totalStock %></div>
        <div class="stat-label">Total Stock Units</div>
      </div>
      <div class="stat-card stat-card-3">
        <div class="stat-top"><div class="stat-icon stat-icon-3">🗂️</div></div>
        <div class="stat-value"><%= categories.length %></div>
        <div class="stat-label">Categories</div>
      </div>
      <div class="stat-card stat-card-4">
        <div class="stat-top"><div class="stat-icon stat-icon-4">⭐</div><span class="stat-trend">4.9★</span></div>
        <div class="stat-value">50K+</div>
        <div class="stat-label">Happy Customers</div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-head">
        <h2>Recent Products</h2>
        <a href="/admin/products" class="btn btn-xs btn-xs-ghost">View All →</a>
      </div>
      <table class="admin-table">
        <thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>
        <tbody>
          <% recentProducts.forEach(function(p){ %>
            <tr>
              <td><div style="display:flex;align-items:center;gap:.875rem;"><img src="<%= p.image %>" class="table-thumb" onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100'"><span class="table-name"><%= p.name %></span></div></td>
              <td><span class="cat-pill"><%= p.category %></span></td>
              <td><strong>$<%= p.price.toFixed(2) %></strong></td>
              <td><span class="<%= p.stock>10?'stock-ok':p.stock>0?'stock-low':'stock-out' %>"><%= p.stock %></span></td>
              <td class="table-actions">
                <a href="/products/<%= p._id %>" class="btn btn-xs btn-xs-ghost" target="_blank">View</a>
                <a href="/admin/products/<%= p._id %>/edit" class="btn btn-xs btn-xs-blue">Edit</a>
                <form action="/admin/products/<%= p._id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Delete?')">
                  <button type="submit" class="btn btn-xs btn-xs-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
