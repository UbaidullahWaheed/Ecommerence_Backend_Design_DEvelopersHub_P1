<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb-nav">
      <a href="/">Home</a><span class="breadcrumb-sep">›</span><span>Products</span>
      <% if(selectedCategory&&selectedCategory!=='All'){%><span class="breadcrumb-sep">›</span><span><%= selectedCategory %></span><%}%>
    </div>
    <h1><%= search ? `Results for "${search}"` : selectedCategory&&selectedCategory!=='All' ? selectedCategory : 'All Products' %></h1>
    <p><%= total %> product<%= total!==1?'s':'' %> found<% if(search){ %> for "<%= search %>"<% } %></p>
  </div>
</section>

<div class="filter-section">
  <div class="container">
    <form class="filter-inner" action="/products" method="GET" id="filterForm">
      <div class="search-wrap">
        <span class="search-icon-left">🔍</span>
        <input type="text" name="search" class="search-input" placeholder="Search products, brands, categories..." value="<%= search %>"/>
        <button type="submit" class="search-btn">Search</button>
      </div>

      <select name="category" class="filter-select" onchange="document.getElementById('filterForm').submit()">
        <% categories.forEach(function(cat){ %>
          <option value="<%= cat %>" <%= selectedCategory===cat?'selected':'' %>><%= cat %></option>
        <% }) %>
      </select>

      <select name="sort" class="filter-select" onchange="document.getElementById('filterForm').submit()">
        <option value="newest" <%=selectedSort==='newest'?'selected':''%>>Newest First</option>
        <option value="price-asc" <%=selectedSort==='price-asc'?'selected':''%>>Price: Low → High</option>
        <option value="price-desc" <%=selectedSort==='price-desc'?'selected':''%>>Price: High → Low</option>
        <option value="rating" <%=selectedSort==='rating'?'selected':''%>>Top Rated</option>
        <option value="name" <%=selectedSort==='name'?'selected':''%>>Name A–Z</option>
      </select>

      <% if(search||selectedCategory!=='All'){ %>
        <a href="/products" class="btn btn-ghost btn-sm">✕ Clear</a>
      <% } %>

      <div class="filter-results"><%= total %> result<%= total!==1?'s':'' %></div>
    </form>
  </div>
</div>

<section class="section">
  <div class="container">
    <!-- Category chips -->
    <div class="filter-chips" style="margin-bottom:2rem;">
      <% const chipCats=['All','Electronics','Clothing','Books','Home & Living','Sports','Beauty','Toys'] %>
      <% chipCats.forEach(function(c){ %>
        <a href="/products?category=<%= encodeURIComponent(c) %>&sort=<%= selectedSort %>" class="filter-chip <%= selectedCategory===c?'active':'' %>"><%= c %></a>
      <% }) %>
    </div>

    <% if(products&&products.length>0){ %>
      <div class="product-grid">
        <% products.forEach(function(p){ %>
          <article class="product-card">
            <a href="/products/<%= p._id %>" class="product-img-wrap">
              <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400'">
              <div class="product-badges">
                <% if(p.stock===0){%><span class="badge badge-out">Out of Stock</span><%}%>
                <% if(p.featured){%><span class="badge badge-featured">⭐</span><%}%>
                <% if(p.originalPrice&&p.originalPrice>p.price){%><span class="badge badge-sale">-<%= Math.round((1-p.price/p.originalPrice)*100) %>%</span><%}%>
              </div>
              <button class="product-wishlist" onclick="event.preventDefault();toggleWish(this)">🤍</button>
              <div class="product-quick-add" onclick="event.preventDefault();alert('Added to cart! 🛒')">+ Quick Add</div>
            </a>
            <div class="product-body">
              <div class="product-category"><%= p.category %></div>
              <h3 class="product-name"><a href="/products/<%= p._id %>"><%= p.name %></a></h3>
              <div class="product-rating">
                <span class="stars">★★★★★</span>
                <span class="rating-val"><%= p.rating?p.rating.toFixed(1):'4.5' %> (<%= p.numReviews||0 %>)</span>
              </div>
              <div class="product-footer">
                <div class="product-price">
                  <span class="price-current">$<%= p.price.toFixed(2) %></span>
                  <% if(p.originalPrice&&p.originalPrice>p.price){ %><span class="price-old">$<%= p.originalPrice.toFixed(2) %></span><% } %>
                </div>
                <a href="/products/<%= p._id %>" class="btn btn-xs btn-xs-primary">View →</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <% if(totalPages>1){ %>
        <nav class="pagination">
          <% if(currentPage>1){ %>
            <a href="/products?page=<%= currentPage-1 %>&search=<%= search %>&category=<%= selectedCategory %>&sort=<%= selectedSort %>" class="page-btn page-btn-prev">← Prev</a>
          <% } %>
          <% for(let i=Math.max(1,currentPage-2);i<=Math.min(totalPages,currentPage+2);i++){ %>
            <a href="/products?page=<%= i %>&search=<%= search %>&category=<%= selectedCategory %>&sort=<%= selectedSort %>" class="page-btn <%= currentPage===i?'active':'' %>"><%= i %></a>
          <% } %>
          <% if(currentPage<totalPages){ %>
            <a href="/products?page=<%= currentPage+1 %>&search=<%= search %>&category=<%= selectedCategory %>&sort=<%= selectedSort %>" class="page-btn page-btn-next">Next →</a>
          <% } %>
        </nav>
      <% } %>

    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">🔍</div>
        <h3>No products found</h3>
        <p>Try different search terms or browse all categories.</p>
        <a href="/products" class="btn btn-primary">View All Products</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
