<%- include('partials/header') %>

<section class="product-detail-section">
  <div class="container">
    <div class="breadcrumb-nav" style="margin-bottom:2rem;">
      <a href="/">Home</a><span class="breadcrumb-sep">›</span>
      <a href="/products">Products</a><span class="breadcrumb-sep">›</span>
      <a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a>
      <span class="breadcrumb-sep">›</span><span style="color:var(--gray-800)"><%= product.name %></span>
    </div>

    <div class="product-detail-grid">
      <!-- Gallery -->
      <div class="product-gallery">
        <div class="product-main-img">
          <img src="<%= product.image %>" alt="<%= product.name %>" onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600'">
          <% if(product.stock===0){%><div class="stock-overlay">Out of Stock</div><%}%>
        </div>
        <div class="product-thumbnails">
          <div class="product-thumb active">🖼️</div>
          <div class="product-thumb">🔍</div>
          <div class="product-thumb">📐</div>
          <div class="product-thumb">📦</div>
        </div>
      </div>

      <!-- Info -->
      <div class="product-info">
        <div class="product-category"><%= product.category %></div>
        <h1><%= product.name %></h1>
        <div class="product-rating" style="margin-bottom:.5rem;">
          <span class="stars-lg">★★★★★</span>
          <span class="rating-val" style="font-size:.9rem;"><%= product.rating?product.rating.toFixed(1):'4.5' %> out of 5 (<%= product.numReviews||0 %> reviews)</span>
        </div>

        <div class="product-price-block">
          <span class="price-xl">$<%= product.price.toFixed(2) %></span>
          <% if(product.originalPrice&&product.originalPrice>product.price){ %>
            <span class="price-xl-old">$<%= product.originalPrice.toFixed(2) %></span>
            <span class="price-xl-save">You save $<%= (product.originalPrice-product.price).toFixed(2) %> (<%= Math.round((1-product.price/product.originalPrice)*100) %>%)</span>
          <% } %>
        </div>

        <div class="product-meta-grid">
          <span class="meta-key">Availability</span>
          <span class="meta-val <%= product.stock>0?'in-stock':'out-stock' %>"><%= product.stock>0?`✅ In Stock (${product.stock} units)`:'❌ Out of Stock' %></span>
          <span class="meta-key">Category</span>
          <span class="meta-val"><a href="/products?category=<%= encodeURIComponent(product.category) %>" style="color:var(--accent)"><%= product.category %></a></span>
          <span class="meta-key">Rating</span>
          <span class="meta-val">⭐ <%= product.rating?product.rating.toFixed(1):'4.5' %>/5.0</span>
          <span class="meta-key">SKU</span>
          <span class="meta-val" style="font-family:monospace;font-size:.85rem;">SV-<%= product._id.toString().slice(-8).toUpperCase() %></span>
        </div>

        <p class="product-desc"><%= product.description %></p>

        <div class="product-actions-row">
          <% if(product.stock>0){ %>
            <div class="qty-selector">
              <button class="qty-btn" onclick="changeQty(-1)">−</button>
              <input type="number" class="qty-input" id="qty" value="1" min="1" max="<%= product.stock %>">
              <button class="qty-btn" onclick="changeQty(1)">+</button>
            </div>
            <button class="btn btn-primary btn-lg" onclick="alert('🛒 Added to cart! Cart feature coming in Phase 2.')">🛒 Add to Cart</button>
            <button class="btn btn-ghost btn-icon-only" onclick="toggleWishPage(this)" title="Add to Wishlist">🤍</button>
          <% } else { %>
            <button class="btn btn-disabled btn-lg" disabled>Out of Stock</button>
          <% } %>
        </div>

        <div class="product-features">
          <div class="product-feature"><div class="product-feature-icon">🚚</div><span>Free shipping over $50</span></div>
          <div class="product-feature"><div class="product-feature-icon">🔄</div><span>30-day easy returns</span></div>
          <div class="product-feature"><div class="product-feature-icon">🔒</div><span>Secure & encrypted checkout</span></div>
          <div class="product-feature"><div class="product-feature-icon">📦</div><span>Ships within 24 hours</span></div>
          <div class="product-feature"><div class="product-feature-icon">✅</div><span>Quality guaranteed</span></div>
          <div class="product-feature"><div class="product-feature-icon">💬</div><span>24/7 customer support</span></div>
        </div>

        <% if(currentUser&&currentUser.role==='admin'){ %>
          <div class="admin-product-actions">
            <a href="/admin/products/<%= product._id %>/edit" class="btn btn-xs btn-xs-blue">✏️ Edit Product</a>
            <form action="/admin/products/<%= product._id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirm('Delete this product?')">
              <button type="submit" class="btn btn-xs btn-xs-danger">🗑 Delete</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Reviews Section -->
    <div class="reviews-section">
      <h2 class="section-title" style="margin-bottom:1.5rem;">Customer Reviews</h2>
      <div class="reviews-summary">
        <div class="review-big-score">
          <div class="review-score-num"><%= product.rating?product.rating.toFixed(1):'4.5' %></div>
          <div class="review-score-stars">★★★★★</div>
          <div class="review-score-count"><%= product.numReviews||47 %> reviews</div>
        </div>
        <div class="review-bars">
          <% [[5,78],[4,14],[3,5],[2,2],[1,1]].forEach(function(r){ %>
            <div class="review-bar-row">
              <div class="review-bar-label"><%= r[0] %>★</div>
              <div class="review-bar-track"><div class="review-bar-fill" style="width:<%= r[1] %>%"></div></div>
              <div class="review-bar-count"><%= r[1] %>%</div>
            </div>
          <% }) %>
        </div>
      </div>

      <% const reviews=[
        {name:'Ahmed K.',date:'2 days ago',rating:5,text:'Absolutely love this product! Quality is outstanding and shipping was super fast. Would definitely buy again.'},
        {name:'Sara M.',date:'1 week ago',rating:5,text:'Exceeded my expectations! The build quality is excellent and it works exactly as described.'},
        {name:'Bilal R.',date:'2 weeks ago',rating:4,text:'Great product overall. Packaging could be better but the product itself is top notch.'},
      ] %>
      <% reviews.forEach(function(r){ %>
        <div class="review-card">
          <div class="review-header">
            <div class="review-user">
              <div class="review-avatar"><%= r.name.charAt(0) %></div>
              <div><div class="review-name"><%= r.name %></div><div class="review-date"><%= r.date %></div></div>
            </div>
            <span class="stars">★★★★★</span>
          </div>
          <p class="review-body"><%= r.text %></p>
        </div>
      <% }) %>
    </div>

    <!-- Related Products -->
    <% if(related&&related.length>0){ %>
      <div class="related-section">
        <div class="section-header">
          <h2 class="section-title">You May Also <span>Like</span></h2>
          <a href="/products?category=<%= encodeURIComponent(product.category) %>" class="section-link">View All →</a>
        </div>
        <div class="product-grid product-grid-5">
          <% related.forEach(function(p){ %>
            <article class="product-card">
              <a href="/products/<%= p._id %>" class="product-img-wrap">
                <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400'">
              </a>
              <div class="product-body">
                <div class="product-category"><%= p.category %></div>
                <h3 class="product-name"><a href="/products/<%= p._id %>"><%= p.name %></a></h3>
                <div class="product-footer">
                  <span class="price-current">$<%= p.price.toFixed(2) %></span>
                  <a href="/products/<%= p._id %>" class="btn btn-xs btn-xs-ghost">View</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
